# Configuration de l'API key pour le monitoring
# En production, générez une clé sécurisée avec: openssl rand -hex 32
MONITOR_API_KEY=change-me-in-production

# Pour la rotation des clés (optionnel)
# MONITOR_API_KEY_PREVIOUS=your-previous-key-here

# Niveau de log (DEBUG, INFO, WARN, ERROR)
# LOG_LEVEL=INFO

# Login interne (page login.html, sessions par cookie)
# Mettre à "false" si l'authentification est déjà assurée en amont
# (ex: TinyAuth devant Traefik) pour éviter une double protection.
# AUTH_ENABLED=true
